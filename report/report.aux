\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Full set of preacher curls.} The accelerometer (top) and gyroscope (bottom) data from a single set of preacher curls, with the end-of-rep annotations shown as red vertical lines. The set lasted 26.2 seconds and consisted of 8 repetitions to failure. Red numbers indicate the Repitions in Reserve at each point during the set. The last rep, at which point the participant could no longer lift the weight, is a rep taken to failure, with an RiR of 0.}}{4}{}\protected@file@percent }
\newlabel{fig:full_set}{{3}{4}}
